{
  "name": "minefield-js",
  "version": "1.1.0",
  "description": "A javascript implementation of the classic minefield game",
  "private": true,
  "main": "index.js",
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "start": "npm run start --workspace @minefield/game",
    "build": "npm run build --workspace @minefield/game",
    "test": "npm run test --workspace @minefield/main && npm run test --workspace @minefield/bot",
    "lint": "npm run lint --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lppjunior/minefield-js.git"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14"
  },
  "author": "Luiz Paulo <luizpaulo@gmail.com>",
  "license": "MIT License",
  "engines": {
    "node": "26.x",
    "npm": ">=8.0.0"
  }
}
